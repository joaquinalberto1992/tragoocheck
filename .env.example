# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Clave secreta de Stripe (sk_live_... o sk_test_...) para procesar pagos con tarjeta en MXN.
STRIPE_SECRET_KEY=""

# VITE_STRIPE_PUBLIC_KEY: Clave pública de Stripe (pk_live_... o pk_test_...).
VITE_STRIPE_PUBLIC_KEY=""
