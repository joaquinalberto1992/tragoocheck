# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Clave de servidor de Stripe (solo Vercel). Acepta rk_test_/sk_test_ en Preview y rk_live_/sk_live_ en Production.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Secreto whsec_ del webhook de Stripe para el ambiente correspondiente.
STRIPE_WEBHOOK_SECRET=""
# Opcional: número oficial de WhatsApp en formato internacional, solo dígitos.
WHATSAPP_NUMBER="524792293687"
