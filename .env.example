# Local-only administrator token (generate a unique random value; never commit .env.local).
ADMIN_TOKEN=""

# Stripe server keys. Keep secrets only in .env.local or Vercel Environment Variables.
# Preview: STRIPE_SECRET_KEY should be a test restricted key.
# Production: set STRIPE_SECRET_KEY_LIVE to a live restricted key.
STRIPE_SECRET_KEY=""
STRIPE_SECRET_KEY_LIVE=""
STRIPE_WEBHOOK_SECRET=""

# Public support number, international digits only.
WHATSAPP_NUMBER="524792293687"

# Public measurement IDs only. These are not secrets; set them in Vercel's
# Production Environment Variables before enabling Google/Meta measurement.
VITE_GA4_ID=""
VITE_META_PIXEL_ID=""
VITE_META_PIXEL_MATCHING_DISABLED="false"
